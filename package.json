{
  "name": "asset-tracker",
  "version": "0.9.5",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev --turbopack",
    "build": "node prisma/set-schema.mjs && prisma generate && prisma migrate deploy && next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint src/",
    "db:seed": "prisma db seed",
    "db:demo-seed": "node prisma/demo-seed.js",
    "db:demo-reset": "node scripts/reset-demo-db.mjs",
    "create-admin": "node scripts/create-admin.mjs",
    "test": "vitest run",
    "test:ui": "npx playwright test --ui",
    "test:mobile": "npx playwright test --project='Mobile Chrome'",
    "test:report": "npx playwright show-report",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:a11y": "playwright test accessibility"
  },
  "dependencies": {
